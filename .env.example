# Copy to ~/.config/opencode-telegram-bot/.env and fill in the four values
# marked TODO. Never commit this file with real values.

# From @BotFather
TELEGRAM_BOT_TOKEN=TODO

# Your own Telegram user id. Message the bot once, then read it from the bot log.
# This restricts who can drive the agent through Telegram — do not skip it.
TELEGRAM_ALLOWED_USER_ID=TODO

# The shared OpenCode server. Both the bot and the Live TUI talk to this one
# instance, which is what makes them the same conversation in real time.
OPENCODE_API_URL=http://localhost:4096

# Must be byte-identical to OPENCODE_SERVER_PASSWORD in opencode-serve.service.
# The setup script generates one and writes it to both places.
OPENCODE_SERVER_PASSWORD=__SERVER_PASSWORD__

# Which model the bot drives.
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=TODO

OPENCODE_SERVER_VERSION=v2

# Set to true if the bot cannot reach Telegram over IPv6 on your network.
TELEGRAM_FORCE_IPV4=true